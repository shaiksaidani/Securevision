# Copy this file to ".env" and adjust. Never commit the real .env file.

# Development mode. Set to False in production.
SV_DEBUG=True

# Leave empty in development: a random key is generated once and saved to
# .dev_secret_key. In production you MUST set a long random value here.
SV_SECRET_KEY=

SV_ALLOWED_HOSTS=localhost,127.0.0.1
SV_TIME_ZONE=Asia/Kolkata

# How long a signed-in session lasts without activity (seconds). 8 hours.
SV_SESSION_AGE=28800

# Secure (HTTPS-only) cookies. Keep False while using http://127.0.0.1:8000
SV_SECURE_COOKIES=False

# Show "No account found with this email." on sign-in and password reset.
# False = generic messages that don't reveal whether an account exists.
SV_REVEAL_UNKNOWN_EMAIL=True

# Role authorization codes used by the sign-up role dropdown.
# Choose your own long, random values. Anyone who knows a code can create an
# account with that role, so share them only with the right people.
# Leave a value empty to stop that role being chosen at sign-up.
SV_TEAM_LEADER_SIGNUP_CODE=
SV_ADMIN_SIGNUP_CODE=

# Only enable if running behind a trusted reverse proxy.
SV_TRUST_X_FORWARDED_FOR=False

# Database: "sqlite" (default) or "postgresql"
SV_DB_ENGINE=sqlite
SV_DB_NAME=
SV_DB_USER=
SV_DB_PASSWORD=
SV_DB_HOST=localhost
SV_DB_PORT=5432

# Email. The console backend prints password-reset emails in the terminal.
SV_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
SV_EMAIL_HOST=
SV_EMAIL_PORT=587
SV_EMAIL_HOST_USER=
SV_EMAIL_HOST_PASSWORD=
SV_EMAIL_USE_TLS=True
SV_DEFAULT_FROM_EMAIL=SecureVision <no-reply@securevision.local>
# Sign-in lockout
SV_LOCKOUT_ATTEMPTS=5
SV_LOCKOUT_MINUTES=15

# ---- Production / HTTPS (see DEPLOYMENT.md). Leave as-is for local development. ----
SV_BEHIND_HTTPS_PROXY=False
SV_SSL_REDIRECT=False
SV_HSTS_SECONDS=0
SV_HSTS_INCLUDE_SUBDOMAINS=False
SV_CSRF_TRUSTED_ORIGINS=
SV_SERVE_STATIC=False